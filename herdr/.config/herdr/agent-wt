#!/usr/bin/env bash
# agent-wt: one feature = one git worktree + herdr workspace + agent + dev server.
# Project-agnostic: everything is detected (lockfile, package.json scripts, gitignored files)
# and all state lives in ~/.local/state/agent-wt, so nothing is ever written into the repo.
#
#   agent-wt new [branch] [task...]   create the worktree, start its dev server and an agent
#   agent-wt status                   what this worktree's agent is doing (herdr popup)
#   agent-wt done [--force]           remove this feature: workspace, worktree, branch, state
#   agent-wt brief                    Claude SessionStart hook: tells the agent its URL and rules
#   agent-wt verify                   Claude Stop hook: typecheck/lint/test must pass to finish
#
# brief/verify do nothing outside worktrees made by `new`, so they are safe as global hooks.

set -euo pipefail
HERDR="${HERDR_BIN_PATH:-herdr}"
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/agent-wt"
MAX_ROUNDS=3 # failed verify rounds before the agent is allowed to stop and hand over to you

die() { echo "agent-wt: $*" >&2; exit 1; }
top() { git -C "$1" rev-parse --show-toplevel 2>/dev/null; }
state_dir() { echo "$STATE_ROOT/$(basename "$1")-$(printf %s "$1" | cksum | cut -d' ' -f1)"; }
has_script() { [[ -f $1/package.json ]] && jq -e --arg s "$2" '.scripts[$s]' "$1/package.json" >/dev/null 2>&1; }

pm() {
	if [[ -f $1/bun.lock || -f $1/bun.lockb ]]; then echo bun
	elif [[ -f $1/pnpm-lock.yaml ]]; then echo pnpm
	elif [[ -f $1/yarn.lock ]]; then echo yarn
	elif [[ -f $1/package.json ]]; then echo npm
	fi
}

# Fingerprint of everything the agent could have changed: commits, tracked edits, new files.
tree_hash() {
	(
		cd "$1"
		git rev-parse HEAD
		git diff HEAD
		git ls-files -o --exclude-standard -z | xargs -0 cksum 2>/dev/null
	) | cksum
}

cmd_new() {
	local src repo branch task out wt pane sd p port name devcmd="" hook
	src="${HERDR_ACTIVE_PANE_CWD:-$PWD}"
	repo=$(top "$src") || die "not inside a git repo: $src"
	branch="${1:-}"
	shift || true
	task="$*"
	if [[ -z $branch && -n ${HERDR_ACTIVE_PANE_CWD:-} ]]; then
		# The popup (no args): a small form. \001..\002 keep readline's width maths right.
		local label=$'\001\e[1;38;2;217;119;87m\002' off=$'\001\e[0m\002'
		printf '\e[2J\e[2;4H\e[1mNew feature\e[0m\e[3;4H\e[2mworktree + dev server + agent  ·  from %s\e[0m' "$(basename "$repo")"
		printf '\e[6;4H\e[2mtask\e[0m\e[9;4H\e[2m⏎ next  ·  task is optional  ·  empty branch or ctrl-c cancels\e[0m\e[5;1H'
		read -erp "   ${label}branch${off}  " branch
		[[ -n $branch ]] || exit 0
		read -erp "   ${label}task${off}    " task
		printf '\e[9;1H\e[J   \e[2mcreating %s…\e[0m\n' "$branch"
		# Errors would vanish with the popup, so hold it open until a key is pressed.
		trap 's=$?; [[ $s == 0 ]] || read -rsn1 -p "   press any key" || true; exit $s' EXIT
	fi
	[[ -n $branch ]] || read -rp "branch: " branch
	[[ -n $branch ]] || exit 0

	out=$("$HERDR" worktree create --cwd "$repo" --branch "$branch" --label "$branch" --focus) || die "$out"
	wt=$(jq -r '.result.worktree.path' <<<"$out")
	pane=$(jq -r '.result.root_pane.pane_id' <<<"$out")
	[[ -d $wt ]] || die "herdr did not return a worktree: $out"

	# A fresh worktree has only tracked files. Bring over gitignored *files* (.env, generated
	# data); ignored *directories* (node_modules, dist, .next) are rebuilt, not copied.
	git -C "$repo" ls-files --others --ignored --exclude-standard --directory -z |
		while IFS= read -r -d '' f; do
			[[ $f == */ || $f == *.log || $f == *.DS_Store ]] && continue
			mkdir -p "$wt/$(dirname "$f")"
			cp -n "$repo/$f" "$wt/$f" || true
		done

	# Stable port per worktree, bumped if something already listens there.
	port=$((3100 + $(printf %s "$wt" | cksum | cut -d' ' -f1) % 900))
	while nc -z localhost "$port" 2>/dev/null; do port=$((port + 1)); done

	# A repo whose dev stack can't be detected gets a hook, agent-wt.d/<main checkout's name>,
	# which sets $port and $devcmd itself.
	hook="$(dirname "$0")/agent-wt.d/$(basename "$(dirname "$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)")")"
	[[ ! -f $hook ]] || . "$hook"

	sd=$(state_dir "$wt")
	mkdir -p "$sd"
	tree_hash "$wt" >"$sd/verified" # nothing to verify until the agent changes something
	rm -f "$sd/rounds"
	printf '# %s\n\n## Goal\n%s\n\n## Done\n\n## Now\n\n## Needs you\n' "$branch" "${task:-(not set yet)}" >"$sd/STATUS.md"

	p=$(pm "$wt")
	if [[ -z $devcmd && -n $p ]]; then
		devcmd="$p install"
		if ! has_script "$wt" dev; then
			port="" # nothing will listen, so don't advertise a URL nobody serves
		# --port is understood by vite, next, astro and friends; PORT covers most of the rest.
		elif [[ $p == npm ]]; then
			devcmd+=" && PORT=$port npm run dev -- --port $port"
		else
			devcmd+=" && PORT=$port $p run dev --port $port"
		fi
	fi
	[[ -n $devcmd ]] || port=""
	[[ -z $port ]] || echo "$port" >"$sd/port"
	if [[ -n $devcmd ]]; then
		# The servers get their own tab, so the agent keeps the whole first one.
		out=$("$HERDR" tab create --workspace "${pane%%:*}" --cwd "$wt" --label servers --no-focus)
		# Not `pane run`: once zsh is up it pastes bracketed, which zsh here rejects ("bad pattern: [200~…").
		out=$(jq -r '.result.root_pane.pane_id' <<<"$out")
		"$HERDR" pane send-text "$out" "$devcmd" >/dev/null && "$HERDR" pane send-keys "$out" enter >/dev/null
	fi

	# herdr agent names: [a-z][a-z0-9_-]{0,31}
	name=$(printf %s "$branch" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | sed 's/^[^a-z]*//' | cut -c1-32)
	if [[ ${AGENT_WT_KIND:-claude} != none ]]; then
		if "$HERDR" agent start "${name:-agent}" --kind "${AGENT_WT_KIND:-claude}" --pane "$pane" >/dev/null 2>&1; then
			[[ -z $task ]] || "$HERDR" agent prompt "${name:-agent}" "$task" >/dev/null 2>&1 ||
				echo "could not send the task; it is saved in STATUS.md"
		else
			# Usually Claude's one-time "trust this folder?" prompt, which is yours to answer.
			# The task is delivered once the agent is past it.
			echo "agent is waiting on a prompt (trust this folder?); answer it and the task will be sent"
			[[ -z $task ]] || nohup sh -c '"$0" agent wait "$1" --until idle --timeout 300000 && "$0" agent prompt "$1" "$2"' \
				"$HERDR" "${name:-agent}" "$task" >/dev/null 2>&1 &
		fi
	fi
	echo "$branch → $wt${port:+ (http://localhost:$port)}"
}

# Shared guard for the hooks: resolve this session's worktree, exit quietly if it isn't ours.
ours() {
	WT=$(top "$PWD") || exit 0
	SD=$(state_dir "$WT")
	[[ -d $SD ]] || exit 0
}

cmd_brief() {
	ours
	local dev="No dev server was started for this worktree. If you need one, start it on a free port and
  put its URL in STATUS.md. Ports already in use belong to other agents; never use them."
	[[ ! -f $SD/port ]] || dev="This worktree's dev server: http://localhost:$(cat "$SD/port") (started in this workspace's 'servers' tab; the app may
  be served under a base path, check the dev output). Other ports belong to other agents; never use them."
	cat <<EOF
You are working in a dedicated git worktree for one feature (branch: $(git -C "$WT" branch --show-current)).
The user runs several agents in parallel and is not watching this one, so verify your own work:

- $dev
- When you try to finish, typecheck, lint and tests run automatically and you are sent back if they fail.
  Run them yourself first.
- For anything visible in the UI: open the dev URL with the Playwright browser tools, exercise the change,
  read the console for errors, and screenshot at 1440px and 390px wide. Look at the screenshots, fix what is
  wrong, and repeat until it is right.
- Keep $SD/STATUS.md current (sections: Goal, Done, Now, Needs you; under 20 lines). The user reads it to
  catch up when switching to you. Update it before you stop or ask a question, and put what you verified
  and what they should look at under "Needs you".
- Stay inside this worktree. Do not push, merge, or touch other worktrees.
EOF
}

cmd_verify() {
	ours
	local hash p s log rounds
	hash=$(tree_hash "$WT")
	[[ $hash == "$(cat "$SD/verified" 2>/dev/null)" ]] && exit 0 # unchanged since the last pass
	p=$(pm "$WT")
	[[ -n $p ]] || exit 0
	# A missing tool is your environment's problem, not something the agent can fix.
	command -v "$p" >/dev/null || { jq -n --arg m "agent-wt: '$p' not on PATH, checks skipped" '{systemMessage: $m}'; exit 0; }
	log="$SD/verify.log"
	for s in typecheck lint test; do
		has_script "$WT" "$s" || continue
		if ! (cd "$WT" && "$p" run "$s") >"$log" 2>&1; then
			rounds=$(($(cat "$SD/rounds" 2>/dev/null || echo 0) + 1))
			echo "$rounds" >"$SD/rounds"
			if ((rounds > MAX_ROUNDS)); then
				rm -f "$SD/rounds"
				jq -n --arg m "agent-wt: '$p run $s' still failing after $MAX_ROUNDS fix attempts; see $log" '{systemMessage: $m}'
				exit 0
			fi
			echo "'$p run $s' failed (attempt $rounds/$MAX_ROUNDS). Fix it before finishing:" >&2
			tail -n 60 "$log" >&2
			exit 2 # exit 2 from a Stop hook sends stderr back to the agent and keeps it working
		fi
	done
	echo "$hash" >"$SD/verified"
	rm -f "$SD/rounds"
}

cmd_status() {
	local wt sd main base state url="" n w
	wt=$(top "${HERDR_ACTIVE_PANE_CWD:-$PWD}") || die "not inside a git repo"
	sd=$(state_dir "$wt")
	main=$(git -C "$wt" worktree list --porcelain | sed -n '1s/^worktree //p')
	base=$(git -C "$main" rev-parse HEAD)
	state=$("$HERDR" agent list 2>/dev/null |
		jq -r --arg wt "$wt" 'first(.result.agents[] | select(.cwd == $wt) | .agent_status // empty)' 2>/dev/null) || true
	[[ ! -f $sd/port ]] || url="http://localhost:$(cat "$sd/port")"
	n=$(git -C "$wt" status --porcelain | wc -l | tr -d ' ')
	w=$({ stty size </dev/tty | cut -d' ' -f2; } 2>/dev/null) || true
	{
		# Title line: branch, what the agent is doing right now, where to look at the result.
		printf '\n \e[1;36m%s\e[0m%s%s\n' "$(git -C "$wt" branch --show-current)" \
			"${state:+   ● $state}" "${url:+   $'\e[4m'$url$'\e[0m'}"
		if [[ -f $sd/STATUS.md ]]; then
			# The agent's sections, most urgent first, whatever order, heading level and line breaks
			# it wrote them with: each paragraph or bullet is rejoined, then wrapped to the popup.
			awk -v w="$((${w:-80} - 2))" '
				function flush() { if (cur != "") { item[k, ++cnt[k]] = cur; cur = "" } }
				/^#+ / { flush(); sub(/^#+ +/, ""); k = tolower($0); if (!(k in cnt)) { order[++n] = k; cnt[k] = 0 }; next }
				k == "" { next }
				/^[ \t]*$/ { flush(); next }
				/^[-*] / { flush(); cur = $0; next }
				{ sub(/^[ \t]+/, ""); cur = (cur == "" ? $0 : cur " " $0) }
				function emit(k,  i, j, m, words, line, pad) {
					if (k in shown || !cnt[k]) return
					shown[k]
					printf "\n \033[1;%sm%s\033[0m\n", (k == "needs you" ? 33 : 34), toupper(k)
					for (i = 1; i <= cnt[k]; i++) {
						pad = (item[k, i] ~ /^[-*] / ? "     " : "   ") # wrapped bullet lines hang under their text
						m = split(item[k, i], words, " ")
						line = "   " words[1]
						for (j = 2; j <= m; j++)
							if (length(line) + 1 + length(words[j]) > w) { print line; line = pad words[j] }
							else line = line " " words[j]
						print line
					}
				}
				END {
					flush(); emit("needs you"); emit("now"); emit("done"); emit("goal")
					for (i = 1; i <= n; i++) emit(order[i])
				}' "$sd/STATUS.md"
		else
			printf '\n   Not an agent-wt feature, so there is no agent status here.\n'
		fi
		printf '\n \e[1;34mCHANGES\e[0m\n   %s uncommitted, %s committed on this branch\n' \
			"$n file$([[ $n == 1 ]] || echo s)" "$(git -C "$wt" rev-list --count "$base..HEAD")"
		# Where the uncommitted work is, by area; the files themselves are a prefix+f away.
		git -C "$wt" status --porcelain | cut -c4- | cut -d/ -f1-2 | sort | uniq -c | sort -rn |
			awk '{ printf "%s%s (%s)", (NR > 1 ? " · " : "   "), $2, $1 } END { if (NR) print "" }'
		git -C "$wt" log --oneline "$base..HEAD" | sed -n '1,5s/^/   /p'
	} | less -Rc~
}

cmd_done() {
	local force="" wt main branch ws sd note="" ans
	[[ ${1:-} == --force ]] && force=1
	wt=$(top "${HERDR_ACTIVE_PANE_CWD:-$PWD}") || die "not inside a git repo"
	main=$(git -C "$wt" worktree list --porcelain | sed -n '1s/^worktree //p')
	[[ $wt != "$main" ]] || die "this is the main checkout, not a feature worktree"
	branch=$(git -C "$wt" branch --show-current)
	sd=$(state_dir "$wt")

	if [[ -n $(git -C "$wt" status --porcelain) ]]; then
		[[ -n $force ]] || die "$branch has uncommitted changes; commit them, or use: agent-wt done --force"
		note+=$'\n  uncommitted changes will be LOST'
	fi
	if ! git -C "$main" branch --merged HEAD --format='%(refname:short)' | grep -qxF "$branch"; then
		[[ -n $force ]] && note+=$'\n  unmerged commits on the branch will be LOST' ||
			note+=$'\n  branch is kept: it has commits not merged into the main checkout'
	fi
	read -rp "Remove feature '$branch' ($wt)?$note"$'\n[y/N] ' ans
	[[ $ans == [yY] ]] || exit 0

	ws=$("$HERDR" workspace list | jq -r --arg wt "$wt" '.result.workspaces[] | select(.worktree.checkout_path == $wt) | .workspace_id' | head -1)
	rm -rf "$sd"
	# Detached, because removing the workspace kills the pane this is running in.
	cd "$main"
	nohup sh -c '
		# Dev servers outlive their pane (pnpm does not forward SIGHUP, zellij keeps its session),
		# so stop whatever still runs from inside the worktree before it is removed.
		lsof -a -d cwd -Fpn 2>/dev/null |
			awk -v wt="$1" "/^p/ {pid = substr(\$0, 2)} /^n/ {d = substr(\$0, 2); if (d == wt || index(d, wt \"/\") == 1) print pid}" |
			xargs kill 2>/dev/null
		if [ -n "$3" ]; then "$0" worktree remove --workspace "$3" ${4:+--force}; else git worktree remove ${4:+--force} "$1"; fi &&
			git branch "$5" "$2"
	' "$HERDR" "$wt" "$branch" "$ws" "$force" "$([[ -n $force ]] && echo -D || echo -d)" >/dev/null 2>&1 &
}

cmd="${1:-}"
shift || true
case $cmd in
new | status | brief | verify | done) "cmd_$cmd" "$@" ;;
*) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
