#!/bin/zsh
# herdr prefix+a popup: pick an agent, open it in a new tab (same folder as the current pane).
# Keys: up/down or j/k to move, enter to open, 1-3 to open directly, esc/q to cancel.

names=(claude opencode codex)
colors=('217;119;87' '250;178;131' '16;163;127') # per-agent accent, RGB
if [[ -f ~/Library/Fonts/HerdrAgentIconsMax-Regular.ttf ]]; then
	# Vendor logos; kitty needs: symbol_map U+E1A0-U+E1C5 Herdr Agent Icons Max
	icons=($'' $'' $'')
else
	icons=('✻' '◆' '◎')
fi
n=$#names
sel=1

draw() {
	local size=($(stty size)) i
	local rows=$size[1] cols=$size[2]
	local top=$(((rows - n - 4) / 2 + 1)) # block = title, gap, n rows, gap, hint
	local left=$(((cols - 13) / 2 + 1))   # rows are 13 cells wide: "❯ " + icon + gap + longest name
	local title='Open agent' hint='↑↓ move · ⏎ open · esc cancel'
	print -n '\e[2J'
	print -n "\e[$top;$(((cols - $#title) / 2 + 1))H\e[1m$title\e[0m"
	for i in {1..$n}; do
		print -n "\e[$((top + 1 + i));${left}H"
		if ((i == sel)); then
			print -n "\e[1;38;2;${colors[i]}m❯ ${icons[i]}  ${names[i]}\e[0m"
		else
			print -n "  \e[38;2;${colors[i]}m${icons[i]}\e[0m  \e[2m${names[i]}\e[0m"
		fi
	done
	print -n "\e[$((top + n + 3));$(((cols - $#hint) / 2 + 1))H\e[2m$hint\e[0m"
}

print -n '\e[?25l'
trap 'print -n "\e[?25h"' EXIT
while true; do
	draw
	read -rsk1 key
	case $key in
	$'\e')
		rest=
		read -rsk2 -t 0.05 rest
		case $rest in
		'[A' | 'OA') ((sel = sel > 1 ? sel - 1 : n)) ;;
		'[B' | 'OB') ((sel = sel < n ? sel + 1 : 1)) ;;
		'') exit ;;
		esac
		;;
	k) ((sel = sel > 1 ? sel - 1 : n)) ;;
	j) ((sel = sel < n ? sel + 1 : 1)) ;;
	[1-$n]) sel=$key && break ;;
	$'\n' | $'\r' | ' ') break ;;
	q) exit ;;
	esac
done

a=$names[sel]
id=$("$HERDR_BIN_PATH" tab create --workspace "$HERDR_ACTIVE_WORKSPACE_ID" --cwd "$HERDR_ACTIVE_PANE_CWD" --label "$a" --focus |
	sed -n 's/.*"pane_id":"\([^"]*\)".*/\1/p')
"$HERDR_BIN_PATH" pane run "$id" "$a"
